# ── Django ────────────────────────────────────────────────────────────────────
# REQUIRED — no default, startup fails without it
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_long_random_50_char_string
# REQUIRED — explicitly set to False in production (no default)
DEBUG=False
ALLOWED_HOSTS=CHANGE_ME_hostname,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://CHANGE_ME_hostname:8844
# Optional — Django TIME_ZONE (IANA name). Default America/Los_Angeles.
# Does not change the Celery Beat timezone (set separately in celery_app.py).
TIME_ZONE=America/Los_Angeles
# Optional HTTPS enforcement (set to True behind a TLS terminator)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=backdeezup
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=backdeezup
# Must match POSTGRES_PASSWORD above
DATABASE_URL=postgres://backdeezup:CHANGE_ME_db_password@db:5432/backdeezup

# ── Cache / broker ────────────────────────────────────────────────────────────
# REQUIRED — no default in docker-compose.yml. redis's --requirepass and every
# service's REDIS_URL depend on it; the stack won't come up healthy without it.
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Gmail scopes (gmail.readonly + gmail.modify) are added automatically.
# For permanent hard delete add https://mail.google.com/ to GOOGLE_EXTRA_SCOPES.
# GOOGLE_EXTRA_SCOPES=
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
GOOGLE_ENCRYPTION_KEY=CHANGE_ME_44_char_fernet_key
GOOGLE_CLIENT_SECRETS=secrets/google_client.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
GOOGLE_MIME_ALLOWLIST=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime,video/x-msvideo
# Optional: Gmail push notifications via Pub/Sub (reduces sync lag from 6h to seconds)
# GMAIL_PUBSUB_TOPIC=projects/<your-project-id>/topics/backdeezup-gmail-push

# ── Pipeline behaviour ────────────────────────────────────────────────────────
DRIVE_DELETE_MODE=trash
MIN_RETENTION_DAYS=3
# Files at or above this size use HTTP Range resumable download (append to an
# existing .part file across retries/restarts) instead of whole-file retry.
# Only affects raw Drive downloads with a known size (Google Docs/Sheets/Slides
# exports and Photos items with an unknown size are unaffected). Phase 42.
RESUME_MIN_MB=50
# Max Drive downloads in flight at once, via a Redis semaphore. Default matches
# today's effective worker concurrency (docker-compose.yml: `celery -c 2`).
# Set to 0 to disable (no cap beyond the worker's own concurrency). Phase 43.
MAX_CONCURRENT_DOWNLOADS=2
# Cap on Google API download calls per second, via a Redis token bucket. 0 =
# disabled (today's behavior -- no cap). Independent of the 429/5xx exponential
# backoff (Phases 10-11), which is unchanged. Phase 43.
GOOGLE_API_MAX_RPS=0

# ── Storage ───────────────────────────────────────────────────────────────────
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles


# ── Media Vault (Wagtail) ─────────────────────────────────────────────────────
WAGTAIL_SITE_NAME=BackDeezUp Media Vault
WAGTAILADMIN_BASE_URL=http://CHANGE_ME_hostname:8844

# ── Scheduler ────────────────────────────────────────────────────────────────
# Set to 1 to enable background scheduler (incremental sync + cleanup rules 3x/day)
# Leave as 0 until you have reviewed and enabled rules via /admin/
BACKDEEZUP_SCHEDULER=0

# ── Notifications (Phase 33) ─────────────────────────────────────────────────
# All off by default -- set only the channels you want. Each event is rate-limited
# to once per hour. Events: backup_task_failure, oauth_revoked, disk_low,
# no_successful_backup, cleanup_executed, integrity_problems_found.
# NOTIFY_WEBHOOK_URL=https://example.com/hooks/backdeezup
# NOTIFY_SLACK_URL=https://hooks.slack.com/services/CHANGE_ME
# NOTIFY_DISCORD_URL=https://discord.com/api/webhooks/CHANGE_ME
# NOTIFY_EMAIL_TO=you@example.com
# Hours without a successful backup before the stale-backup Beat check fires. 0 = disabled.
NOTIFY_STALE_BACKUP_HOURS=0
# Only used if NOTIFY_EMAIL_TO is set
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=CHANGE_ME
# EMAIL_HOST_PASSWORD=CHANGE_ME
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=backdeezup@example.com

# ── Cleanup safeguards (Phase 34) ─────────────────────────────────────────────
# Global pause: skips every REAL cleanup run (run-all, Beat, make cleanup-run,
# the dashboard Execute button) with a log line. Dry runs are unaffected.
CLEANUP_PAUSED=0
# Dry-run-required + exact-count confirm on the Execute button only -- ON by default.
# Does NOT block run_all_enabled_rules / make cleanup-run / Beat (those only honor
# CLEANUP_PAUSED above).
CLEANUP_REQUIRE_DRY_RUN=1
CLEANUP_DRY_RUN_MAX_AGE_HOURS=24

# ── Export to ZIP/TAR (Phase 36) ───────────────────────────────────────────────
# Above this many resolved items, /dashboard/export/ runs as a Celery task
# writing to MEDIA_ROOT/exports/ and shows a download link instead of streaming.
# scope=everything always goes async regardless of count.
EXPORT_ASYNC_THRESHOLD=200

# ── Restore to local dir (Phase 37) ───────────────────────────────────────────
# Uncomment to restore somewhere other than MEDIA_ROOT/restores. Every restore
# destination must resolve inside this root -- traversal outside it is rejected.
# RESTORE_ROOT=/path/to/restores
# Off by default: only gates the optional weekly Beat check. The dashboard
# "Can I restore a file?" button always works regardless of this flag.
RESTORE_SMOKE_TEST_ENABLED=0

# ── PostgreSQL backup (Phase 38) ──────────────────────────────────────────────
# `make db-backup` / `make db-restore FILE=...` always work. This flag only
# gates the OPTIONAL weekly Beat task that also takes a dump and prunes old
# ones down to DB_BACKUP_KEEP_LAST -- off by default.
DB_BACKUP_ENABLED=0
DB_BACKUP_KEEP_LAST=14
# DB_BACKUP_DIR=/app/backups

# ── Compose ports / bind address (Phase 39) ──────────────────────────────────
# Host interface docker-compose publishes web/nginx ports on. Default 127.0.0.1
# (localhost only). Set BIND_ADDR=0.0.0.0 to expose on the LAN -- WSL mirrored
# networking makes 127.0.0.1 reachable from the Windows browser regardless, so
# most vertex-dev-style setups don't need 0.0.0.0 at all.
# BIND_ADDR=0.0.0.0
# WEB_PORT=8845
# NGINX_HTTP_PORT=8844
# NGINX_HTTPS_PORT=8445

# ── Prebuilt image (Phase 47) ─────────────────────────────────────────────────
# Default: web/celery/celerybeat build locally from this repo's Dockerfile and
# tag the result backdeezup:local -- `make build` behaves exactly as before.
# Set this to a published release tag to skip building and use that image
# instead (after `docker compose pull`): see docs/releases.md.
# BACKDEEZUP_IMAGE=ghcr.io/devadalberto/backdeezup:v1.2.3

# ── Optional Caddy reverse proxy (Phase 48) ───────────────────────────────────
# Off by default -- nginx above is what `docker compose up` starts. Opt in with
# `docker compose --profile caddy up -d`. Defaults below (localhost + Caddy's own
# internal CA) work with zero config, same trust model as nginx's self-signed dev
# cert. Set a real DOMAIN + CADDY_TLS_MODE=you@example.com for automatic HTTPS via
# Let's Encrypt instead -- see docs/deployment.md.
# DOMAIN=localhost
# CADDY_TLS_MODE=internal

# ── Admin UI labels ───────────────────────────────────────────────────────────
ADMIN_SITE_HEADER=BackDeezUp
ADMIN_SITE_TITLE=BackDeezUp Admin
ADMIN_INDEX_TITLE=Dashboard
SWAGGER_TITLE=BackDeezUp API
SWAGGER_VERSION=0.4.0
